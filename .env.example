ANNICT_ACCESS_TOKEN="Your Annict Access Token Here"

# Google Analytics 4（アクセス計測）— GA コンソールで発行する測定 ID
# 例: G-XXXXXXXXXX。未設定なら計測は無効（dev でも常に無効）
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Google Sheets（既存のデータソース）
VITE_GOOGLE_SHEETS_API_KEY="Your Google Sheets API Key"
VITE_SPREADSHEET_ID="Your Spreadsheet ID"
# Spotify（OFF-HOURS の「最近よく聴いている曲」。Vercel Function 専用・VITE_ を付けない）
# 手順は docs/spotify-setup.md
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REFRESH_TOKEN=""
# GitHub（ACTIVITY のコントリビューションとリポジトリ。Vercel Function 専用・VITE_ を付けない）
# 公開リポジトリの読み取りだけの fine-grained token。GITHUB_TOKEN ではなくこの名前で。手順は docs/github-setup.md
GITHUB_READ_TOKEN=""
# --- IGNORE ---
# ANNICT_ACCESS_TOKEN="ここにあなたの実際のアクセストークンを